page {
  min-height: 100%;
  background: #f7f7f2;
  color: #161713;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
}

button {
  border-radius: 999rpx;
  font-weight: 700;
}

button::after {
  border: 0;
}

.safe-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
}

.eyebrow {
  color: #71736c;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 0.14em;
  text-transform: uppercase;
}

.primary-button {
  height: 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #c7fa38;
  color: #141511;
  font-size: 32rpx;
  border-radius: 24rpx;
}

.secondary-button {
  background: #e9e7df;
  color: #24251f;
}
