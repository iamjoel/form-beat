.profile-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f7f7f2;
}

.profile-scroll {
  min-height: 0;
  flex: 1 1 auto;
}

.profile-content {
  box-sizing: border-box;
  padding: 40rpx 32rpx 64rpx;
}

.profile-title,
.profile-subtitle {
  display: block;
}

.profile-title {
  font-size: 48rpx;
  font-weight: 760;
  letter-spacing: -0.04em;
}

.profile-subtitle {
  margin-top: 10rpx;
  color: #686a63;
  font-size: 25rpx;
}

.identity-section {
  display: flex;
  align-items: center;
  gap: 36rpx;
  margin-top: 60rpx;
  padding-bottom: 56rpx;
  border-bottom: 2rpx solid #d8d9d2;
}

.profile-photo {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  flex: 0 0 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  overflow: hidden;
  border-radius: 50%;
  background: #c8ef3f;
  color: #171813;
}

.profile-photo image {
  width: 100%;
  height: 100%;
}

.profile-initial {
  font-size: 54rpx;
  font-weight: 760;
}

.photo-action {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  box-sizing: border-box;
  padding: 7rpx 0 12rpx;
  background: rgba(14, 15, 13, 0.72);
  color: #f7f7f2;
  font-size: 19rpx;
  font-weight: 650;
  text-align: center;
}

.name-field {
  min-width: 0;
  flex: 1 1 auto;
}

.name-field > text {
  display: block;
  color: #686a63;
  font-size: 23rpx;
  font-weight: 650;
}

.name-field input {
  height: 96rpx;
  border-bottom: 2rpx solid #171813;
  color: #171813;
  font-size: 42rpx;
  font-weight: 720;
}

.recording-section {
  margin-top: 58rpx;
}

.setting-title,
.setting-copy {
  display: block;
}

.setting-title {
  font-size: 34rpx;
  font-weight: 720;
}

.setting-copy {
  max-width: 600rpx;
  margin-top: 10rpx;
  color: #686a63;
  font-size: 23rpx;
  line-height: 1.55;
}

.recording-options {
  display: flex;
  gap: 14rpx;
  margin-top: 30rpx;
}

.recording-option {
  min-width: 0;
  height: 160rpx;
  flex: 1 1 33.333%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 0;
  padding: 0;
  border: 2rpx solid #d8d9d2;
  border-radius: 24rpx;
  background: transparent;
  color: #171813;
  font-size: 23rpx;
}

.recording-option text:first-child {
  font-size: 46rpx;
  line-height: 1;
}

.recording-option--selected {
  border-color: #171813;
  background: #171813;
  color: #f7f7f2;
}

.privacy-note {
  display: block;
  margin-top: 60rpx;
  color: #686a63;
  font-size: 21rpx;
  line-height: 1.5;
}

.profile-nav {
  box-sizing: content-box;
  padding-bottom: env(safe-area-inset-bottom);
}
