<view class="completion-page">
  <view class="success-ring">
    <text>✓</text>
  </view>
  <text class="eyebrow">WORKOUT COMPLETE</text>
  <text class="title">完成 {{exerciseLabel}}</text>
  <view class="stats-card">
    <view class="stat">
      <text class="stat-value">{{count}}</text>
      <text class="stat-label">完成次数</text>
    </view>
    <view class="divider"></view>
    <view class="stat">
      <text class="stat-value">{{durationLabel}}</text>
      <text class="stat-label">训练用时</text>
    </view>
  </view>
  <text class="saved-note">原始相机录像已保存到本机记录</text>
  <view class="completion-actions">
    <button class="primary-button" bindtap="backHome">返回锻炼</button>
    <button class="records-button" bindtap="openRecords">查看体能</button>
  </view>
</view>
