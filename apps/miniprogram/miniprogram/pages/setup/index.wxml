<view class="setup-page">
  <view class="setup-content">
    <view class="setup-section">
      <text class="section-title">动作</text>
      <view class="exercise-options">
        <button
          wx:for="{{exercises}}"
          wx:key="id"
          class="exercise-option {{exerciseId === item.id ? 'exercise-option--selected' : ''}}"
          data-id="{{item.id}}"
          aria-label="选择{{item.label}}"
          bindtap="selectExercise"
        >{{item.label}}</button>
      </view>
    </view>

    <view class="setup-section">
      <text class="section-title">次数</text>
      <view class="target-stepper">
        <button
          class="stepper-control"
          data-delta="-1"
          disabled="{{target <= 1}}"
          aria-label="减少一次"
          bindtap="changeTarget"
        >−</button>
        <view class="target-value">
          <text class="target-number">{{target}}</text>
          <text class="target-unit">次</text>
        </view>
        <button
          class="stepper-control"
          data-delta="1"
          disabled="{{target >= 99}}"
          aria-label="增加一次"
          bindtap="changeTarget"
        >＋</button>
      </view>
    </view>

  </view>

  <view class="setup-footer">
    <button
      class="start-button"
      aria-label="开始{{exerciseLabel}}，目标{{target}}次"
      bindtap="startWorkout"
    >开始</button>

    <view class="main-nav">
      <button class="nav-button" aria-label="体能" bindtap="openFitness">
        <view class="nav-glyph nav-glyph--calendar"></view>
        <text>体能</text>
      </button>
      <button class="nav-button" aria-label="动作" bindtap="openActions">
        <view class="nav-glyph nav-glyph--actions"></view>
        <text>动作</text>
      </button>
      <button class="nav-button nav-button--active" aria-label="锻炼，当前页面">
        <view class="nav-glyph nav-glyph--workout"></view>
        <text>锻炼</text>
      </button>
      <button class="nav-button" aria-label="个人" bindtap="openProfile">
        <view class="nav-glyph nav-glyph--profile"></view>
        <text>个人</text>
      </button>
    </view>
  </view>

  <view wx:if="{{showDemo}}" class="demo-screen">
    <view class="demo-header">
      <button class="demo-back" aria-label="返回训练设置" bindtap="closeDemo">‹</button>
      <view class="demo-heading">
        <text class="demo-eyebrow">动作演示</text>
        <text class="demo-title">{{exerciseLabel}}</text>
      </view>
      <view class="demo-header-spacer"></view>
    </view>

    <view class="demo-content">
      <view class="demo-canvas-frame">
        <canvas
          id="exercise-demo-canvas"
          class="demo-canvas"
          type="2d"
          aria-label="哈士奇正在演示{{exerciseLabel}}，画面标有训练时使用的骨骼点和关键角度"
        ></canvas>
        <view
          wx:if="{{demoStatus !== 'ready'}}"
          class="demo-status"
          role="status"
          aria-live="polite"
        >
          <view wx:if="{{demoStatus === 'loading'}}" class="demo-loading-spinner"></view>
          <text>{{demoStatus === 'loading' ? '正在准备动作演示' : '动作演示加载失败'}}</text>
        </view>
      </view>

      <checkbox-group class="demo-preference" bindchange="changeDemoPreference">
        <label class="demo-skip">
          <checkbox value="skip" checked="{{skipDemo}}" color="#171813"></checkbox>
          <text>不再提示</text>
        </label>
      </checkbox-group>
    </view>

    <view class="demo-footer">
      <button class="demo-start" bindtap="continueWorkout">开始训练</button>
    </view>
  </view>
</view>
