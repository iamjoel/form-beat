.records-page {
  display: flex;
  flex-direction: column;
  gap: 34rpx;
}

.records-heading {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 20rpx;
}

.title {
  font-size: 62rpx;
  font-weight: 880;
  letter-spacing: -0.055em;
}

.subtitle {
  color: #73756d;
  font-size: 25rpx;
  line-height: 1.5;
}

.empty-state {
  min-height: 760rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  text-align: center;
}

.empty-mark {
  color: #a7d42a;
  font-size: 100rpx;
  line-height: 1;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 800;
}

.empty-copy {
  max-width: 500rpx;
  color: #74766f;
  font-size: 24rpx;
  line-height: 1.55;
}

.empty-button {
  width: 380rpx;
  margin-top: 30rpx;
}

.record-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.record-card {
  overflow: hidden;
  border-radius: 30rpx;
  background: #fffef9;
  box-shadow: 0 12rpx 36rpx rgba(35, 37, 28, 0.07);
}

.record-header,
.record-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.record-title,
.record-date {
  display: block;
}

.record-title {
  font-size: 30rpx;
  font-weight: 820;
}

.record-date,
.record-duration {
  margin-top: 6rpx;
  color: #7a7c74;
  font-size: 21rpx;
}

.record-count {
  font-size: 30rpx;
  font-weight: 850;
}

.record-video {
  width: 100%;
  height: 620rpx;
  display: block;
  background: #171813;
}

.record-actions {
  display: flex;
  gap: 10rpx;
}

.record-action {
  margin: 0;
  padding: 0 24rpx;
  background: #eceae3;
  color: #292a25;
  font-size: 22rpx;
}

.record-delete {
  color: #a83333;
}
