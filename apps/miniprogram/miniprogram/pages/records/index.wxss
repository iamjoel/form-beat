.fitness-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f7f7f2;
}

.fitness-scroll {
  min-height: 0;
  flex: 1 1 auto;
}

.fitness-content {
  box-sizing: border-box;
  padding: 0 0 48rpx;
}

.today-panel {
  box-sizing: border-box;
  margin-top: 0;
  padding: 40rpx 32rpx 48rpx;
  background: #171813;
  color: #f7f7f2;
}

.summary-row {
  display: flex;
  margin-top: 0;
}

.summary-item {
  min-width: 0;
  flex: 1 1 33.333%;
}

.summary-item + .summary-item {
  box-sizing: border-box;
  padding-left: 0;
  border-left: 0;
}

.summary-item:nth-child(2) {
  text-align: center;
}

.summary-item:last-child {
  text-align: right;
}

.summary-label,
.summary-value {
  display: block;
}

.summary-label {
  color: #aeb0a7;
  font-size: 26rpx;
  font-weight: 600;
}

.summary-value {
  margin-top: 16rpx;
  overflow: hidden;
  font-size: 52rpx;
  font-weight: 720;
  letter-spacing: -0.04em;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.summary-value text {
  margin-left: 5rpx;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 0;
}

.summary-item:nth-child(2) .summary-value {
  color: #c8ef3f;
  font-size: 52rpx;
  font-weight: 800;
}

.summary-item:last-child .summary-value text {
  font-size: 18rpx;
}

.history-section {
  margin-top: 64rpx;
  padding: 0 32rpx;
}

.calendar-heading {
  min-height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-title {
  font-size: 34rpx;
  font-weight: 720;
}

.month-switcher {
  height: 80rpx;
  display: flex;
  align-items: center;
}

.month-switcher button {
  width: 80rpx;
  height: 80rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: transparent;
  font-size: 52rpx;
  font-weight: 350;
  line-height: 1;
}

.month-switcher button[disabled] {
  color: #aeb0a7;
  opacity: 0.36;
}

.month-switcher text {
  min-width: 172rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  font-size: 24rpx;
  font-weight: 650;
  line-height: 1;
  text-align: center;
}

.calendar-weekdays,
.calendar-grid {
  display: flex;
  flex-wrap: wrap;
}

.calendar-weekdays {
  padding-bottom: 12rpx;
  border-bottom: 2rpx solid #d8d9d2;
}

.calendar-weekdays text,
.calendar-cell {
  width: 14.2857%;
  min-width: 0;
  flex: 0 0 14.2857%;
}

.calendar-weekdays text {
  color: #686a63;
  font-size: 20rpx;
  font-weight: 650;
  text-align: center;
}

.calendar-grid {
  padding-top: 16rpx;
}

.calendar-cell,
.calendar-day,
.calendar-blank {
  height: 92rpx;
  box-sizing: border-box;
}

.calendar-day {
  position: relative;
  width: 92rpx;
  min-width: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  padding: 0;
  background: transparent;
  color: #171813;
  line-height: 1;
}

.calendar-day--interactive {
  max-width: 92rpx;
  background: transparent;
}

.calendar-day-visual {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
}

.calendar-day-visual text {
  position: relative;
  z-index: 1;
  color: #171813;
  font-size: 26rpx;
  font-weight: 650;
  line-height: 1;
}

.calendar-day-visual--active {
  background: #c8ef3f;
}

.calendar-day-visual--active text {
  font-weight: 760;
}

.calendar-day--today text {
  border-bottom: 2rpx solid #171813;
}

.day-dot {
  position: absolute;
  right: 10rpx;
  bottom: 8rpx;
  width: 7rpx;
  height: 7rpx;
  z-index: 1;
  border-radius: 50%;
  background: #171813;
}

.calendar-hint {
  display: block;
  margin-top: 18rpx;
  color: #686a63;
  font-size: 21rpx;
}

.fitness-nav {
  box-sizing: content-box;
  padding-bottom: env(safe-area-inset-bottom);
}
